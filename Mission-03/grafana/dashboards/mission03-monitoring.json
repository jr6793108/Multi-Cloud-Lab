{
  "uid": "mission03-monitoring",
  "title": "Mission-03 - Application & Infrastructure Monitoring",
  "tags": [
    "mission03",
    "terraform",
    "prometheus",
    "grafana"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Application Availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mission03-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"mission03-application\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mission03-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "HTTP Requests per Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mission03-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(mission03_http_requests_total[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mission03-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "HTTP Response Latency (Average)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mission03-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(mission03_http_request_duration_seconds_sum[5m])) / clamp_min(sum(rate(mission03_http_request_duration_seconds_count[5m])), 0.000001)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mission03-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "CPU Utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mission03-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mission03-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Memory Utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mission03-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mission03-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Root Filesystem Utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mission03-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mission03-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
